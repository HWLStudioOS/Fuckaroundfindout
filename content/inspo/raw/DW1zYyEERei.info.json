q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.instagram.com/"}, "format": "dash-1566074634691726v - 720x1280 (DASH video)"}, {"format_id": "dash-1440071457186658v", "ext": "mp4", "width": 1080, "height": 1920, "tbr": 1476.05, "format_note": "DASH video", "container": "mp4_dash", "vcodec": "vp09.00.40.08.00.01.01.01.00", "acodec": "none", "dynamic_range": "SDR", "url": "https://instagram.ffab1-2.fna.fbcdn.net/o1/v/t2/f2/m367/AQNUOmqOHihs4DY56OBakzewwwRzf3sdugQtiRAt5fFU8qb1Di-2ry-G2guuRTvKnB2XkqqJjyysI2FoX-CiGeJW9a8DdaDl8s6ymkc.mp4?_nc_cat=101&_nc_oc=Adq4HaNOFNTt1XluifWGm_4Mq0E-VsBtJhNmSm4T0FJuHTT18tx9HZ5uBftqf5gOi5CFNsDn5juQRu3yBBqomA7N&_nc_sid=9ca052&_nc_ht=instagram.ffab1-2.fna.fbcdn.net&_nc_ohc=UpTHEZfsCcgQ7kNvwFKkgpB&%3D&ccb=17-1&_nc_gid=GoEsX0BX1ZyXvfyisyBPuw&_nc_zt=28&_nc_ss=7a22e&oh=00_Af4dpWf69du2jRJ19zg7OlNRDG05edWejLNg9azUiNVfFA&oe=6A1118EE", "manifest_stream_number": 0, "is_dash_periods": true, "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 1476.05, "resolution": "1080x1920", "aspect_ratio": 0.56, "filesize_approx": 25085100, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/139.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.instagram.com/"}, "format": "dash-1440071457186658v - 1080x1920 (DASH video)"}], "title": "Video by kirk.lepiten", "description": "I spent seven years working for a big creator, but I was living vicariously through their success instead of building my own brand. After being encouraged to spread my wings, I took the leap into freelancing and eventually started my own content creation journey in January. My friend @capt.rikki is also sharing his experience and why it's worth betting on yourself, even though leaving comfort is scary. Because sometimes safe is just another word for stagnant.", "duration": 135.958, "timestamp": 1775586941, "uploader_id": "35639542046", "uploader": "Kirk Lepiten", "channel": "kirk.lepiten", "like_count": 3681, "comment_count": 88, "comments": [{"author": "keswickginger", "author_id": "49176826702", "id": "18201030790353353", "text": "Happy for you.  I'll battle you in a drone dog fight any day for content... I assure you I'll cheat", "timestamp": 1778162857}, {"author": "lucian_petrean", "author_id": "6632546654", "id": "18090219338206309", "text": "So So …. Well said @kirk.lepiten \nI’m feeling exactly that this year and want to start betting on myself instead 👏🔥", "timestamp": 1778162652}, {"author": "adriandayphotography", "author_id": "431414851", "id": "17941171617196263", "text": "But ….. you are killing it and have a connection with the camera… and voice for video ! You’re going to grow and grow …. \nI worked for a successful company about five years ago… since leaving I’ve shared a few things online but about 5 months ago though let’s try doing this for me… and I feel like I have tanked ! I’m posting every day sharing my photography but I’m yet to do the video side .. because I don’t know if I have the face or the personality for being the face of “Adrian Day” {Me} but I just can grow doing what I’m doing now! I need to do something more! .. even though I have 25 years in the photography industry I’m sure I’ve got stuck in the safe zone..", "timestamp": 1778088340}, {"author": "rodmandewitt", "author_id": "1152888717", "id": "17916108504360697", "text": "So proud of you dude, i remember the early couple of tutorials you did on his channel and it sick to see this now ❤️", "timestamp": 1777953329}, {"author": "wosu_1", "author_id": "66072499225", "id": "18111380491837400", "text": "Bro, go for it!", "timestamp": 1777666160}, {"author": "you_need_an_ac", "author_id": "42543928184", "id": "18579769159014696", "text": "Im on that stage to start doing too 🔥", "timestamp": 1777306670}, {"author": "mattheram", "author_id": "266111400", "id": "17864051181545312", "text": "Epic Kirk best of luck to you man 👏👏👏🙌😊👌🏻", "timestamp": 1776628469}, {"author": "marchanddimages", "author_id": "59658577942", "id": "17933216190238331", "text": "Ho damn man! So well said, thank you!🙏 your content is always inspiring!", "timestamp": 1776217390}], "thumbnails": [{"url": "https://instagram.ffab1-2.fna.fbcdn.net/v/t51.71878-15/657876010_25671679475838258_1186225211750682552_n.jpg?stp=dst-jpg_e15_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6ImltYWdlX3VybGdlbi42NDAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuYzIifQ&_nc_ht=instagram.ffab1-2.fna.fbcdn.net&_nc_cat=106&_nc_oc=Q6cZ2gEE3jaTeyfe7gJ-8JfNSb2dSzYbE6d_NBXGfb7KuO0NQLDyqi4agz_gAr80kcvIzRwW_PlXNYyEw9NA9ejgbCp0&_nc_ohc=qPFKhgQWPfIQ7kNvwE7CjuV&_nc_gid=GoEsX0BX1ZyXvfyisyBPuw&edm=ANTKIIoBAAAA&ccb=7-5&oh=00_Af4u3sEaFwasV8wx5AXKvboB7pB40ZYOIZsALq4UrTUQTQ&oe=6A110889&_nc_sid=d885a2", "width": 640, "height": 1136, "id": "0", "resolution": "640x1136"}, {"url": "https://instagram.ffab1-2.fna.fbcdn.net/v/t51.71878-15/657876010_25671679475838258_1186225211750682552_n.jpg?stp=dst-jpg_e15_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6ImltYWdlX3VybGdlbi42NDAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuYzIifQ&_nc_ht=instagram.ffab1-2.fna.fbcdn.net&_nc_cat=106&_nc_oc=Q6cZ2gEE3jaTeyfe7gJ-8JfNSb2dSzYbE6d_NBXGfb7KuO0NQLDyqi4agz_gAr80kcvIzRwW_PlXNYyEw9NA9ejgbCp0&_nc_ohc=qPFKhgQWPfIQ7kNvwE7CjuV&_nc_gid=GoEsX0BX1ZyXvfyisyBPuw&edm=ANTKIIoBAAAA&ccb=7-5&oh=00_Af4u3sEaFwasV8wx5AXKvboB7pB40ZYOIZsALq4UrTUQTQ&oe=6A110889&_nc_sid=d885a2", "width": 750, "height": 1331, "id": "1", "resolution": "750x1331"}, {"url": "https://instagram.ffab1-2.fna.fbcdn.net/v/t51.71878-15/657876010_25671679475838258_1186225211750682552_n.jpg?stp=dst-jpg_e15_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6ImltYWdlX3VybGdlbi42NDAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuYzIifQ&_nc_ht=instagram.ffab1-2.fna.fbcdn.net&_nc_cat=106&_nc_oc=Q6cZ2gEE3jaTeyfe7gJ-8JfNSb2dSzYbE6d_NBXGfb7KuO0NQLDyqi4agz_gAr80kcvIzRwW_PlXNYyEw9NA9ejgbCp0&_nc_ohc=qPFKhgQWPfIQ7kNvwE7CjuV