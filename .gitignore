# Secrets and credentials
.config/
.secrets/
.tokens/
*.env
*.env.*
!*.env.example

# Private financial and identity documents. Never commit these.
# gitleaks scans for credential patterns in text, so it cannot see inside a
# scanned bank statement or a filled identity form. Those are blocked by path
# instead, here and by the sensitive-path guard in agents/nightly-backup.sh.
private/

# Scratch working directory. Anything here is disposable by definition.
# Real documents belong in a named directory, not in tmp/.
tmp/

# OS junk
.DS_Store
Thumbs.db

# Agent runtime artifacts (logs are kept in agents/_log.md, these are noise)
agents/_stdout.log
agents/_stderr.log
agents/_telegram-agent.log
agents/_telegram-agent-daemon.log

# Backup files
*.bak
*~

# Editor
.vscode/
.idea/

# Python venv (in case anything reintroduces one)
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Node caches and local reports
node_modules/
.npm/
npm-debug.log*
coverage/

# Jarvis runtime state. Documentation and schemas under runtime/ remain trackable.
.jarvis-runtime/
runtime/**/*.db
runtime/**/*.db-wal
runtime/**/*.db-shm
runtime/**/*.db-journal
runtime/**/*.sqlite
runtime/**/*.sqlite-wal
runtime/**/*.sqlite-shm
runtime/**/*.sqlite-journal
runtime/**/*.sqlite3
runtime/**/*.sqlite3-wal
runtime/**/*.sqlite3-shm
runtime/**/*.sqlite3-journal
runtime/**/*.pid
runtime/**/*.sentinel
runtime/**/*.log

# Generated process state and logs (already-tracked history remains tracked)
*.sentinel
*.pid
*.log
agents/_*-sent.json
agents/_*-candidate.txt

# Frozen historical snapshots (each has its own internal .git)
.archive/
.playwright-mcp/

# Health-sync virtualenv
.venv-health/

# Codex vendored snapshot: never include codex secrets or finance data
codex/**/.secrets/
codex/**/finance-inbox/
codex/**/*.env
codex/**/token*.json
codex/**/credential*.json
codex/**/client_secret*.json
