v", "ext": "mp4", "width": 720, "height": 1280, "tbr": 1266.819, "format_note": "DASH video", "container": "mp4_dash", "vcodec": "avc1.64001f", "acodec": "none", "dynamic_range": "SDR", "url": "https://instagram.ffab1-1.fna.fbcdn.net/o1/v/t2/f2/m86/AQM3wSrjVYCXeoWAg858sOmVcDT3lhK6npk6Apb5SDgZw2Deew60iCYQOUVTPUcGlfzmVXJXmOUpbAF_Z6AnYyzG3SB8Xdzl1RgYmD0.mp4?_nc_cat=110&_nc_oc=AdpYSNYNOC0O_aWRJrDEybm0CtxPnBHaFqcUa7lmCt1XT58cVXkRL6J4V1F2uQ7IAXa1cRd_dQwM-BmD11npIlB7&_nc_sid=9ca052&_nc_ht=instagram.ffab1-1.fna.fbcdn.net&_nc_ohc=Of0AK2dcSt0Q7kNvwHM3217&%3D%3D&ccb=17-1&_nc_gid=hAzIcC285pvgLyiTbY7Qmg&_nc_zt=28&_nc_ss=7a22e&oh=00_Af4hq43cUoLjQgP8W3h5Lkv9J4Ix8YC6LY4h4-iWlsVrXw&oe=6A0D3907", "manifest_stream_number": 0, "is_dash_periods": true, "protocol": "https", "video_ext": "mp4", "audio_ext": "none", "abr": 0, "vbr": 1266.819, "resolution": "720x1280", "aspect_ratio": 0.56, "filesize_approx": 9328221, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/139.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.instagram.com/"}, "format": "dash-2153911768749561v - 720x1280 (DASH video)"}], "title": "Video by orbit.media.in", "description": "The best VCs don’t just invest, They broadcast.\n\nCapital is no longer scarce.\nGreat founders aren’t either.\n\nWhat’s scarce is trust at scale.\n\nMedia distribution turns a VC from a logo on a website\ninto a familiar voice in a founder’s head.\n\nWhen founders hear your thinking weekly,\nyour firm stops competing on valuation\nand starts competing on belief.\n\nThat’s the power of distribution.\n\n#VCPodcast\n#VentureCapital\n#StartupEcosystem\n#distribution\n#media", "duration": 58.908, "timestamp": 1766764993, "uploader_id": "74753095231", "uploader": "Orbit Media", "channel": "orbit.media.in", "like_count": 9403, "comment_count": 109, "comments": [{"author": "kickoff.africa", "author_id": "72584927756", "id": "18114799957706055", "text": "And that’s why we exist!", "timestamp": 1777970647}, {"author": "sam__editzzz", "author_id": "40374738688", "id": "18045666257774754", "text": "I love orbit media", "timestamp": 1777865425}, {"author": "get.nachonacho", "author_id": "8432153796", "id": "18164289160425180", "text": "Consistent thinking builds familiarity, and that familiarity turns into trust over time.", "timestamp": 1776099729}, {"author": "piyush.video.editor", "author_id": "58188103220", "id": "18111665392693126", "text": "🔥", "timestamp": 1775210626}, {"author": "wallstreetpaper", "author_id": "9265615", "id": "18096221671816080", "text": "Absolutely spot on—trust and visibility truly set the best VCs apart.", "timestamp": 1773764792}, {"author": "yvonnean_", "author_id": "1744575421", "id": "18100523510293020", "text": "Attention capital market yup", "timestamp": 1773360714}, {"author": "vyron.media", "author_id": "49155622868", "id": "17921601810254627", "text": "🔥🔥", "timestamp": 1772883411}, {"author": "edit_eshwari", "author_id": "76944259526", "id": "18070075754224619", "text": "🔥", "timestamp": 1772595953}, {"author": "wavetheory.insights", "author_id": "49330572442", "id": "17926687377233687", "text": "🔥🔥", "timestamp": 1772325727}], "thumbnails": [{"url": "https://instagram.ffab1-2.fna.fbcdn.net/v/t51.71878-15/605534432_845611748342248_4902015894574902119_n.jpg?stp=dst-jpg_e15_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6ImltYWdlX3VybGdlbi42NDAuc2RyLnZpZGVvX25mcmFtZV9jb3Zlcl9mcmFtZS5jMiJ9&_nc_ht=instagram.ffab1-2.fna.fbcdn.net&_nc_cat=104&_nc_oc=Q6cZ2gFbQ-x6fq2pXemuftI4aDIAWG7Bns8tPMaYBdubQZMWLRdL4InOe24uaKC0I8_s8oyurTGHofDGnR07m7bk-9wb&_nc_ohc=aRipgiJ7luQQ7kNvwEKFNjL&_nc_gid=hAzIcC285pvgLyiTbY7Qmg&edm=ANTKIIoBAAAA&ccb=7-5&oh=00_Af562Si5472e8MWiXn1Swj19Npei-kvpsxfYQzQFbQfVhQ&oe=6A11305A&_nc_sid=d885a2", "width": 640, "height": 1136, "id": "0", "resolution": "640x1136"}, {"url": "https://instagra